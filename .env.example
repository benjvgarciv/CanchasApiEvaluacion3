# ==============================================================================
# Variables de Entorno del Sistema de Gestión de Canchas Deportivas
# Copia este archivo a '.env' y completa con tus valores correspondientes.
# ==============================================================================

# 1. Base de Datos SQL Server
DB_PORT=1433
SQL_PORT=1433
DB_PASSWORD=TuPasswordSeguro123!
SA_PASSWORD=TuPasswordSeguro123!

# 2. Backend ASP.NET Core (.NET 10)
API_PORT=5098
BACKEND_PORT=8080
JWT_KEY=SuperSecretKeyForCanchasApiEvaluacion3_Min32Chars!2026
JWT_ISSUER=CanchasApi
JWT_AUDIENCE=CanchasApp

# 3. Frontend React + Vite
FRONTEND_PORT=80
VITE_API_BASE_URL=http://localhost:5098

# 4. Integración de Inteligencia Artificial Externa (Google Gemini / OpenAI)
AI_API_KEY=
AI_ENDPOINT=https://api.openai.com/v1/chat/completions
GEMINI_API_KEY=
