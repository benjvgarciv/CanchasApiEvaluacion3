# Archivo de Ejemplo de Variables de Entorno
# Copie este archivo como .env y configure los valores correspondientes

# Base de datos SQL Server
SA_PASSWORD=TuPasswordFuerte123!

# Configuración JWT Segura (Llave simétrica mínima de 256 bits / 32+ caracteres)
JWT_KEY=SuperSecretKeyForCanchasApiEvaluacion3_Min32Chars!2026
JWT_ISSUER=CanchasApi
JWT_AUDIENCE=CanchasFrontend

# Servicio de Inteligencia Artificial (Gemini / OpenAI API Key)
GEMINI_API_KEY=AIzaSyTuClaveDeApiAquiParaServicioDeIA

# Puertos expuestos
BACKEND_PORT=8080
FRONTEND_PORT=80
SQL_PORT=1433
